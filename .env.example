# ---- Database (PostgreSQL) ----
# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/ld_portal?schema=public&sslmode=require"
# Direct (non-pooled) connection used for migrations. Same as DATABASE_URL if you have no pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/ld_portal?schema=public&sslmode=require"

# ---- Auth.js ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# ---- Microsoft Entra ID (provided by NESR IT) ----
AUTH_MICROSOFT_ENTRA_ID_ID=""          # Application (client) ID
AUTH_MICROSOFT_ENTRA_ID_SECRET=""      # Client secret value
AUTH_MICROSOFT_ENTRA_ID_ISSUER="https://login.microsoftonline.com/<TENANT_ID>/v2.0"

# Entra App Role value that grants the L&D Team workspace (default LD.Admin)
AUTH_ADMIN_ROLE="LD.Admin"
# Optional comma-separated emails that are always L&D admins (bootstrap before App Roles exist)
ADMIN_EMAILS=""

# ---- Testing only ----
# "true" shows a demo login with sample people (run: npm run db:seed -- --demo). Remove before go-live.
DEMO_LOGIN="false"
