# Variable names match the Digital-NESR Vercel project. Shared ones are probably already set there.

# ---- Database (PostgreSQL) — shared ----
DB_HOST=""
DB_PORT="5432"
DB_USER=""
DB_PASSWORD=""
DB_SSL="true"            # true/require -> sslmode=require, false -> disable
# ---- Database — NEW for L&D: the database name on that server ----
LD_DB_NAME="lnd_trainings"
# Optional: a full connection string instead of the DB_* parts above (takes precedence)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lnd_trainings?sslmode=require"

# ---- Auth — shared ----
NEXTAUTH_SECRET=""       # random 32+ bytes
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""
# Optional: only if IT gives L&D its own Entra app registration (these override AZURE_AD_*)
# LD_AZURE_AD_CLIENT_ID=""
# LD_AZURE_AD_CLIENT_SECRET=""
# LD_AZURE_AD_TENANT_ID=""

# ---- L&D-only settings ----
LD_ADMIN_EMAILS=""       # comma-separated emails that always get the L&D Team workspace
# LD_ADMIN_ROLE="LD.Admin"  # Entra App Role value for the L&D Team (default LD.Admin)
LD_DEMO_LOGIN="false"    # "true" shows a demo login (testing only; run: npm run db:seed -- --demo)
